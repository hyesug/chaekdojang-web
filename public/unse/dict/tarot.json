  "6": {"p":"관계와 선택이 삶의 중요한 주제입니다.","w":"협업·파트너십이 중요한 일에 맞습니다.","m":"파트너와 함께 돈을 다룹니다.","r":"깊은 사랑과 선택의 순간을 겪습니다.","c":"선택을 미루지 마세요."},
  "7": {"p":"의지와 추진력으로 목표를 향해 밀고 갑니다.","w":"경쟁·성과가 분명한 일에 맞습니다.","m":"목표를 정하면 모읍니다.","r":"주도적인 관계를 원합니다.","c":"한쪽으로만 달리지 마세요."},
  "8": {"p":"부드러운 강함이 있고 인내로 이깁니다.","w":"사람을 다루고 설득하는 일에 맞습니다.","m":"참을성 있게 모읍니다.","r":"상대를 부드럽게 이끕니다.","c":"참기만 하지 말고 표현하세요."},
  "9": {"p":"혼자 생각하고 답을 찾는 시간이 필요합니다.","w":"연구·전문 분야에 맞습니다.","m":"신중하게 씁니다.","r":"혼자만의 공간을 원합니다.","c":"고립되지 않게 하세요."},
  "10": {"p":"흐름과 변화를 겪으며 운의 오르내림이 있습니다.","w":"변화가 많은 업계에 맞습니다.","m":"기복이 있으니 좋을 때 모으세요.","r":"관계도 변화를 겪습니다.","c":"좋을 때 방심하지 마세요."},
  "11": {"p":"공정함과 균형을 중시합니다.","w":"법·감사·협상처럼 판단이 필요한 일에 맞습니다.","m":"정당하게 벌고 정당하게 씁니다.","r":"공평한 관계를 원합니다.","c":"너무 냉정하게 재지 마세요."},
  "12": {"p":"관점을 바꿔 보는 능력이 있고, 기다림이 손해가 아닌 사람입니다.","w":"전환과 재해석이 필요한 일에 맞습니다.","m":"기다려서 기회를 잡습니다.","r":"희생적인 사랑을 할 때가 있습니다.","c":"너무 오래 멈춰 있지 마세요."},
