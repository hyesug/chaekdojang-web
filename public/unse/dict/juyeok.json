{
  "1": {"p":"스스로 앞장서야 직성이 풀리고, 목표를 높게 잡습니다.","w":"리더 자리에서 능력이 나옵니다.","m":"큰 판에 투자하는 편입니다.","r":"이끄는 관계를 원합니다.","c":"혼자 너무 높이 올라가면 도와줄 사람이 없습니다."},
  "2": {"p":"받쳐 주고 따라가는 데서 힘을 발휘합니다.","w":"보좌·운영·실무에서 신뢰를 얻습니다.","m":"꾸준히 모읍니다.","r":"상대를 품어 주는 관계를 만듭니다.","c":"앞에 나서야 할 때 물러서지 마세요."},
  "3": {"p":"시작할 때마다 어려움이 따르지만 결국 뚫고 나갑니다.","w":"새로 여는 일에서 초반 고생이 크고, 도와줄 사람을 찾으면 풀립니다.","m":"초기 비용이 많이 듭니다.","r":"관계도 처음이 어렵고 갈수록 단단해집니다.","c":"혼자 다 하려 하지 말고 조력자를 찾으세요."},
  "4": {"p":"배우면서 크는 사람이라, 좋은 스승을 만나면 빠르게 성장합니다.","w":"교육·훈련을 받거나 주는 일에 맞습니다.","m":"배움에 투자한 만큼 돌아옵니다.","r":"이끌어 주는 사람에게 의지합니다.","c":"모르는 걸 아는 척하지 마세요."},
  "5": {"p":"때를 기다릴 줄 알고, 준비가 될 때까지 서두르지 않습니다.","w":"타이밍이 중요한 투자·협상에 맞습니다.","m":"기다려서 좋은 기회를 잡습니다.","r":"서두르지 않고 천천히 다가갑니다.","c":"기다림이 너무 길어지지 않게 기한을 정하세요."},
  "6": {"p":"옳고 그름을 따지는 일이 잦고, 다툼에 휘말리기 쉽습니다.","w":"법률·협상·감사처럼 시비를 가리는 일에 맞습니다.","m":"계약과 소송에 신경 쓸 일이 생기기 쉽습니다.","r":"말다툼이 잦을 수 있습니다.","c":"이기는 것보다 끝내는 것을 택하세요."},
  "7": {"p":"조직을 이끌고 규율을 세우는 힘이 있습니다.","w":"팀장·관리자·지휘하는 역할에 맞습니다.","m":"조직의 돈을 다루는 일과 인연이 있습니다.","r":"관계에서도 질서를 중시합니다.","c":"규율을 앞세우다 정을 잃지 마세요."},
  "8": {"p":"사람과 가까이 붙어 함께하는 데서 힘을 얻습니다.","w":"협력·네트워크·팀워크가 중요한 일에 맞습니다.","m":"함께하는 사람을 통해 돈이 들어옵니다.","r":"친밀한 관계를 소중히 합니다.","c":"아무와 다 친할 필요는 없습니다. 사람을 가려 사귀세요."},
  "9": {"p":"작은 것을 조금씩 모아 크게 만듭니다.","w":"꾸준한 축적이 필요한 일에 맞습니다.","m":"조금씩 모으는 데 능합니다.","r":"천천히 정을 쌓습니다.","c":"너무 작은 것에만 매달리지 마세요."},
  "10": {"p":"예의와 절차를 지키며 조심스럽게 나아갑니다.","w":"매너와 신뢰가 중요한 서비스·외교 업무에 맞습니다.","m":"조심스럽게 관리합니다.","r":"예의 바른 관계를 원합니다.","c":"지나치게 조심하다 시기를 놓칩니다."},
  "11": {"p":"주변과 잘 통하고, 일이 순탄하게 풀리는 편입니다.","w":"협력이 잘 되는 환경에서 성과가 큽니다.","m":"좋은 흐름일 때 대비해 저축하세요.","r":"서로 잘 통하는 관계를 만듭니다.","c":"좋을 때 방심하지 마세요."},
  "12": {"p":"막히는 시기를 겪으며 버티는 힘을 기릅니다.","w":"혼자 준비하며 때를 기다리는 일에 맞습니다.","m":"지출을 줄이고 지키는 데 집중하세요.","r":"소통이 막히면 거리를 두는 편입니다.","c":"막힌다고 포기하지 말고 때를 기다리세요."},
  "13": {"p":"뜻 맞는 사람들과 함께할 때 큰일을 해냅니다.","w":"공동 프로젝트·커뮤니티·단체 활동에 맞습니다.","m":"동업이나 협력으로 돈을 법니다.","r":"동지 같은 관계를 원합니다.","c":"무리 속에서 내 역할을 분명히 하세요."},
  "14": {"p":"가진 것이 많고 베푸는 그릇이 큽니다.","w":"자원을 관리하고 나누는 일에 맞습니다.","m":"재물 복이 있는 편입니다.","r":"너그럽고 베푸는 관계를 만듭니다.","c":"많이 가졌을 때 겸손하세요."},
  "15": {"p":"자신을 낮추고 겸손해서 오히려 신뢰를 얻습니다.","w":"조율·중재·서비스 일에서 인정받습니다.","m":"욕심을 줄이면 오히려 들어옵니다.","r":"상대를 존중하는 관계를 만듭니다.","c":"지나친 겸손으로 내 몫을 놓치지 마세요."},
  "16": {"p":"즐거움과 흥이 많아 분위기를 띄웁니다.","w":"이벤트·엔터·홍보처럼 사람을 즐겁게 하는 일에 맞습니다.","m":"즐기는 데 쓰는 돈이 많습니다.","r":"즐거운 관계를 원합니다.","c":"즐거움에 빠져 준비를 소홀히 하지 마세요."},
  "17": {"p":"흐름을 읽고 상황에 맞춰 따라가는 능력이 좋습니다.","w":"트렌드를 읽는 일, 유연함이 필요한 일에 맞습니다.","m":"흐름을 타는 투자에 감각이 있습니다.","r":"상대에게 잘 맞춰 줍니다.","c":"따라가기만 하다 내 방향을 잃지 마세요."},
  "18": {"p":"썩거나 꼬인 것을 바로잡는 역할을 맡게 됩니다.","w":"구조 조정·개선·수리처럼 문제를 고치는 일에 맞습니다.","m":"물려받은 문제나 빚을 정리하는 일이 생길 수 있습니다.","r":"관계의 묵은 문제를 해결하려 합니다.","c":"남의 문제까지 다 떠안지 마세요."},
  "19": {"p":"다가가서 이끄는 힘이 있고, 사람을 잘 돌봅니다.","w":"교육·관리·멘토링에 맞습니다.","m":"기회가 다가올 때 잡는 감각이 있습니다.","r":"먼저 다가가는 편입니다.","c":"좋은 흐름이 영원하지 않으니 대비하세요."},
  "20": {"p":"움직이기 전에 살피고, 관찰력이 뛰어납니다.","w":"분석·리서치·평가처럼 보는 일에 맞습니다.","m":"살펴보고 신중하게 투자합니다.","r":"상대를 오래 지켜본 뒤 마음을 엽니다.","c":"보기만 하고 움직이지 않으면 기회를 놓칩니다."},
  "21": {"p":"막힌 것을 깨물어 뚫듯 문제를 정면으로 해결합니다.","w":"분쟁 해결·법·결단이 필요한 일에 맞습니다.","m":"걸림돌을 제거하면 돈이 풀립니다.","r":"문제가 있으면 바로 짚고 넘어갑니다.","c":"너무 강하게 밀어붙이지 마세요."},
  "22": {"p":"꾸미고 다듬는 감각이 뛰어납니다.","w":"디자인·뷰티·브랜딩처럼 겉을 다듬는 일에 맞습니다.","m":"외관과 꾸밈에 돈을 씁니다.","r":"멋있게 보이는 관계를 원합니다.","c":"겉보다 속을 채우는 데도 신경 쓰세요."},
  "23": {"p":"하나씩 벗겨지고 정리되는 경험을 하며 단단해집니다.","w":"정리·청산·해체가 필요한 일에 맞습니다.","m":"줄이고 지키는 시기를 겪습니다.","r":"관계에서 정리할 것을 정리합니다.","c":"무리하게 지키려 하기보다 놓을 것을 놓으세요."},
  "24": {"p":"다시 시작하고 회복하는 힘이 강합니다.","w":"재도전·복귀·재건이 필요한 일에 맞습니다.","m":"잃은 뒤 다시 모읍니다.","r":"떨어졌던 인연이 다시 돌아오기도 합니다.","c":"같은 실수를 반복하지 않게 하세요."},
  "25": {"p":"꾸밈없고 순수하며, 계산 없이 움직입니다.","w":"정직함이 중요한 일에서 신뢰를 얻습니다.","m":"욕심 없이 벌 때 오히려 잘 됩니다.","r":"있는 그대로의 관계를 원합니다.","c":"너무 순진해서 이용당하지 않게 하세요."},
  "26": {"p":"크게 쌓아 두고 때를 기다리는 그릇이 있습니다.","w":"축적·연구·자산 관리에 맞습니다.","m":"큰 자산을 모을 가능성이 있습니다.","r":"깊이 있는 관계를 쌓습니다.","c":"쌓기만 하고 쓰지 않으면 의미가 없습니다."},
  "27": {"p":"먹고 말하는 것, 즉 무엇을 들이고 내보내는지가 삶의 핵심입니다.","w":"음식·건강·교육·말하는 일에 맞습니다.","m":"먹고 사는 것에 쓰는 돈이 큽니다.","r":"말 한마디로 관계가 좌우됩니다.","c":"말과 식습관을 조심하세요."},
  "28": {"p":"감당하기 벅찬 짐을 지는 경우가 많습니다.","w":"큰 책임을 맡는 자리에 서게 됩니다.","m":"무리한 투자를 조심하세요.","r":"관계에서 부담을 많이 느낍니다.","c":"짐을 나누지 않으면 무너집니다."},
  "29": {"p":"어려움이 반복되지만 그 속에서 단련됩니다.","w":"위기 대응·리스크 관리에 강합니다.","m":"위험을 다루는 데 신중해야 합니다.","r":"관계에서도 시련을 겪으며 깊어집니다.","c":"같은 함정에 두 번 빠지지 마세요."},
  "30": {"p":"밝고 명확하며, 무언가에 붙어 빛납니다.","w":"교육·미디어·디자인처럼 밝히는 일에 맞습니다.","m":"좋은 파트너와 함께할 때 돈이 됩니다.","r":"함께 빛나는 관계를 원합니다.","c":"너무 의존하지 않게 하세요."},
  "31": {"p":"감정과 끌림에 민감하고, 서로 통하는 감각이 좋습니다.","w":"사람의 마음을 움직이는 일에 맞습니다.","m":"감정적인 지출을 조심하세요.","r":"서로 끌리는 강한 인연을 만납니다.","c":"끌림만으로 결정하지 마세요."},
  "32": {"p":"한결같고 오래 가는 힘이 있습니다.","w":"장기적인 직장·전문 분야에 맞습니다.","m":"꾸준히 오래 모읍니다.","r":"변함없는 관계를 오래 유지합니다.","c":"변해야 할 때도 버티지 마세요."},
  "33": {"p":"물러설 때를 알고, 필요하면 거리를 둡니다.","w":"전략적 후퇴, 독립적인 일에 맞습니다.","m":"위험할 때 빠지는 감각이 있습니다.","r":"지치면 거리를 두는 편입니다.","c":"피하기만 하지 말고 마주할 때도 있어야 합니다."},
  "34": {"p":"힘이 넘치고 기세가 강합니다.","w":"추진력이 필요한 사업·영업에 맞습니다.","m":"기세가 좋을 때 크게 법니다.","r":"강하게 밀고 가는 연애를 합니다.","c":"힘이 셀수록 조심하세요."},
  "35": {"p":"꾸준히 앞으로 나아가며 인정받습니다.","w":"승진·성장이 분명한 조직에 맞습니다.","m":"점점 늘어나는 수입 구조입니다.","r":"관계가 점점 깊어집니다.","c":"앞서가다 주변을 놓치지 마세요."},
  "36": {"p":"어려운 환경에서 빛을 숨기고 때를 기다립니다.","w":"드러나지 않게 실력을 쌓는 일에 맞습니다.","m":"드러내지 않고 조용히 모읍니다.","r":"속마음을 숨기는 편입니다.","c":"너무 오래 숨지 마세요."},
  "37": {"p":"가정과 내 사람을 중요하게 여기고, 집안을 잘 꾸립니다.","w":"가족 사업·조직 운영에 맞습니다.","m":"가정의 살림을 잘 꾸립니다.","r":"가족 같은 관계를 원합니다.","c":"집안일에만 매이지 마세요."},
  "38": {"p":"남과 다른 관점을 가지고, 엇갈림을 겪습니다.","w":"독특한 시각이 필요한 일에 맞습니다.","m":"의견 차이로 돈 문제가 생기기 쉽습니다.","r":"관계에서 오해가 생기기 쉽습니다.","c":"다름을 인정하면 풀립니다."},
  "39": {"p":"앞이 막혔을 때 방향을 바꾸고 도와줄 사람을 찾습니다.","w":"어려운 과제를 협력으로 해결하는 일에 맞습니다.","m":"무리하게 밀어붙이지 말고 돌아가세요.","r":"어려울 때 의지할 사람을 찾습니다.","c":"혼자 버티지 말고 도움을 청하세요."},
  "40": {"p":"묶인 것을 풀고 해결하는 능력이 있습니다.","w":"문제 해결·협상·정리에 맞습니다.","m":"막혔던 돈이 풀립니다.","r":"얽힌 관계를 정리합니다.","c":"풀린 뒤 방심하지 마세요."},
  "41": {"p":"덜어 낼수록 오히려 얻는 것이 많습니다.","w":"효율화·절제가 필요한 일에 맞습니다.","m":"줄여야 모입니다.","r":"내려놓을 때 관계가 좋아집니다.","c":"너무 많이 덜어 내지는 마세요."},
  "42": {"p":"보태고 늘리는 흐름을 잘 탑니다.","w":"성장·확장하는 일에 맞습니다.","m":"투자해서 늘리는 감각이 있습니다.","r":"서로에게 도움이 되는 관계를 만듭니다.","c":"늘릴 때일수록 기반을 다지세요."},
  "43": {"p":"결단하고 끊어 내는 힘이 있습니다.","w":"결정을 내려야 하는 자리에 맞습니다.","m":"과감한 정리로 돈이 돌아옵니다.","r":"끊을 땐 확실히 끊습니다.","c":"결단이 너무 거칠지 않게 하세요."},
  "44": {"p":"우연한 만남과 인연이 삶을 바꿉니다.","w":"새로운 사람을 만나는 일에 맞습니다.","m":"우연한 기회로 돈이 들어옵니다.","r":"갑작스러운 인연을 만납니다.","c":"아무나 믿지 마세요."},
  "45": {"p":"사람을 모으고 한데 묶는 힘이 있습니다.","w":"모임·조직·커뮤니티 운영에 맞습니다.","m":"사람이 모이면 돈도 모입니다.","r":"넓은 인간관계를 가집니다.","c":"모인 사람 관리에 신경 쓰세요."},
  "46": {"p":"한 단계씩 차근차근 올라갑니다.","w":"꾸준한 승진·성장이 있는 일에 맞습니다.","m":"점점 늘어납니다.","r":"천천히 깊어지는 관계를 만듭니다.","c":"단계를 건너뛰지 마세요."},
  "47": {"p":"곤란한 상황에 놓여도 견디며 길을 찾습니다.","w":"어려운 환경에서 버티는 일에 맞습니다.","m":"자금이 막히는 시기를 대비하세요.","r":"말이 통하지 않는 답답함을 겪습니다.","c":"말보다 행동으로 증명하세요."},
  "48": {"p":"한결같이 사람들에게 필요한 것을 공급합니다.","w":"공공·인프라·서비스처럼 꾸준히 필요를 채우는 일에 맞습니다.","m":"안정적인 수입 구조를 만듭니다.","r":"늘 그 자리에 있는 듬직한 존재입니다.","c":"스스로를 관리하지 않으면 메마릅니다."},
  "49": {"p":"낡은 것을 바꾸고 새로 고치는 개혁 성향이 있습니다.","w":"혁신·전환·리모델링에 맞습니다.","m":"방식을 바꿔 수입을 늘립니다.","r":"관계의 방식을 바꾸려 합니다.","c":"바꾸는 이유를 분명히 하세요."},
  "50": {"p":"새로운 것을 만들어 내고 자리를 세웁니다.","w":"요리·제작·창업처럼 새로 만드는 일에 맞습니다.","m":"새로운 기반을 만들어 법니다.","r":"함께 새 출발하는 관계를 원합니다.","c":"기반이 단단한지 먼저 확인하세요."},
  "51": {"p":"갑작스러운 변화에 놀라지만 빠르게 대응합니다.","w":"급변하는 환경에서 순발력이 빛납니다.","m":"갑작스러운 지출에 대비하세요.","r":"관계에서 놀랄 일이 생기기 쉽습니다.","c":"놀란 순간에 결정하지 마세요."},
  "52": {"p":"멈출 때를 알고, 차분하게 자기를 지킵니다.","w":"집중과 명상이 필요한 일에 맞습니다.","m":"움직이지 않고 지키는 데 강합니다.","r":"조용한 관계를 선호합니다.","c":"너무 오래 멈춰 있지 마세요."},
  "53": {"p":"차근차근 순서대로 나아가며 늦게 꽃핍니다.","w":"단계적 성장이 있는 일에 맞습니다.","m":"천천히 꾸준히 늘어납니다.","r":"절차를 거쳐 맺어지는 인연을 만납니다.","c":"조급해하지 마세요."},
  "54": {"p":"자기 뜻보다 상황에 맞춰 따라가는 일이 생깁니다.","w":"주어진 역할을 받아들이는 일에서 성장합니다.","m":"남의 조건에 맞춰야 하는 거래를 조심하세요.","r":"관계에서 내가 원하는 것보다 상황이 앞설 때가 있습니다.","c":"내 기준을 잃지 마세요."},
  "55": {"p":"풍성하고 정점에 서는 시기를 누립니다.","w":"성과가 정점에 이르는 일에 맞습니다.","m":"풍요로울 때 대비해 두세요.","r":"관계가 무르익습니다.","c":"정점 뒤의 내리막을 대비하세요."},
  "56": {"p":"떠돌며 경험을 쌓는 나그네 기질이 있습니다.","w":"출장·여행·이동이 많은 일에 맞습니다.","m":"이동 중에 지출이 많습니다.","r":"한곳에 오래 머물지 않는 관계를 겪습니다.","c":"어디서든 뿌리 하나는 두세요."},
  "57": {"p":"부드럽게 스며들어 영향을 줍니다.","w":"설득·홍보·조율처럼 은근히 움직이는 일에 맞습니다.","m":"조금씩 꾸준히 법니다.","r":"부드럽게 다가갑니다.","c":"우유부단하지 않게 하세요."},
  "58": {"p":"즐겁게 말하고 사람을 기쁘게 합니다.","w":"상담·영업·강의처럼 말로 즐거움을 주는 일에 맞습니다.","m":"말솜씨로 돈을 법니다.","r":"즐거운 대화가 많은 관계를 만듭니다.","c":"말이 가벼워지지 않게 하세요."},
  "59": {"p":"흩어지고 풀리는 흐름 속에서 새로운 중심을 세웁니다.","w":"흩어진 것을 다시 모으는 일에 맞습니다.","m":"돈이 흩어지기 쉬우니 모아 두는 장치가 필요합니다.","r":"멀어졌던 관계를 다시 잇습니다.","c":"중심 없이 흩어지지 않게 하세요."},
  "60": {"p":"절제하고 선을 지키는 데 능합니다.","w":"규칙·예산 관리가 필요한 일에 맞습니다.","m":"절약해서 모읍니다.","r":"적당한 거리를 유지합니다.","c":"지나친 절제는 답답함이 됩니다."},
  "61": {"p":"속에서 우러나는 진심으로 사람을 움직입니다.","w":"신뢰가 중요한 상담·교육 일에 맞습니다.","m":"신용으로 돈이 들어옵니다.","r":"진심이 통하는 관계를 만듭니다.","c":"진심을 이용하는 사람을 조심하세요."},
  "62": {"p":"작은 일에 신중하고, 큰 모험은 피합니다.","w":"세밀한 실무에 맞습니다.","m":"작게 꾸준히 법니다.","r":"조심스럽게 다가갑니다.","c":"너무 작게만 생각하지 마세요."},
  "63": {"p":"이미 이룬 것을 잘 지키는 데 강합니다.","w":"완성된 것을 유지·관리하는 일에 맞습니다.","m":"지키는 데 신경 써야 합니다.","r":"안정된 관계를 유지합니다.","c":"완성 뒤에 방심하면 흐트러집니다."},
  "64": {"p":"아직 끝나지 않은 일을 향해 계속 나아갑니다.","w":"진행 중인 프로젝트, 미래를 준비하는 일에 맞습니다.","m":"앞으로를 위한 투자를 합니다.","r":"관계가 계속 발전합니다.","c":"마무리를 너무 서두르지 마세요."}
}
